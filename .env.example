BOT_TOKEN=
BOT_USERNAME=
PUBLIC_URL=https://YOUR-SHOP-HTTPS-HOST
ADMIN_CHAT_ID=
OWNER_USERNAME=
ADMIN_PASSWORD=
WEBHOOK_SECRET=
SHOP_NAME=Fattle Shop
MONGODB_URI=
MONGODB_DB=telegram_shop

# Group membership gate
REQUIRED_CHAT_INVITE_URL=https://t.me/+23Ao1LMrgLgxMjc9
# Optional. You can leave this blank and run /bindgroup in the group instead.
REQUIRED_CHAT_ID=
REFERRAL_CREDIT=10

# Recommended: generate with Python Fernet.generate_key()
INVENTORY_ENCRYPTION_KEY=

# Optional stronger web-admin security
ADMIN_TOTP_SECRET=
ADMIN_SESSION_HOURS=12

# Optional persistent external image storage. If blank, MongoDB image fallback is used.
CLOUDINARY_URL=

DEFAULT_LOW_STOCK=3

# Paid OTP generation
OTP_PRICE=10

# Cloudinary (recommended: use these 3 separate variables)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Legacy alternative:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Credit purchase display rates
CREDIT_RATE_INR=₹1 = 1 credit
CREDIT_RATE_USD=$1 = 100 credits

# Subscription reminder cron security. Set this in Vercel/hosting environment.
# Vercel Cron automatically sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Telegram admin date-entry timezone. Defaults below are India Standard Time.
# Example: DD-MM-YYYY HH:MM entered in Telegram is interpreted with this offset.
ADMIN_UTC_OFFSET_MINUTES=330
ADMIN_TIMEZONE_LABEL=IST

# Pending fulfillment SLA alerts (admin Telegram + Admin Action Center)
# Warning is sent once after this many hours; urgent is sent once after the urgent threshold.
FULFILLMENT_WARNING_HOURS=6
FULFILLMENT_URGENT_HOURS=24

# Optional emergency revocation for one-tap persistent Shop launchers.
# Leave as 1 normally. Changing this invalidates old Shop buttons; users then run /start once.
SHOP_LAUNCH_VERSION=1

# Optional performance tuning (safe defaults; normally leave unchanged)
MEMBERSHIP_CACHE_SECONDS=180
SHOP_CATALOG_CACHE_SECONDS=3
METHOD_CATALOG_CACHE_SECONDS=10
WEBHOOK_HOUSEKEEPING_SECONDS=300

# Temp Mail backend (Render)
TEMP_MAIL_API_URL=https://your-temp-mail-backend.onrender.com
TEMP_MAIL_API_SECRET=replace-with-a-long-random-secret

# Note: Render also needs the same BOT_TOKEN and MONGODB_URI for Temp Mail inbox auto-refresh.
# Telegram webhook belongs to the shop host (Botkeep after migration).

# Saved-mail history is stored by the Render backend in MongoDB.

# Downloader
DOWNLOADER_API_URL=https://YOUR-COORDINATOR.onrender.com
DOWNLOADER_API_SECRET=...
# Set this only after you migrate the bot to your self-hosted Local Telegram Bot API server.
TELEGRAM_BOT_API_BASE_URL=
